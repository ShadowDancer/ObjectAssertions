<Project>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <LangVersion>11</LangVersion>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>ObjectAssertions</PackageId>
    <AssemblyName>$(PackageId)</AssemblyName>
    <RootNamespace>ObjectAssertions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynApiVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObjectAssertions.Abstractions\ObjectAssertions.Abstractions.csproj" PrivateAssets="All" />
  </ItemGroup>

</Project>
